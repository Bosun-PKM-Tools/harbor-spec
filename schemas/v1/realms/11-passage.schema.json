{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/passage.schema.json",
  "title": "Passage Realm Schema (11)",
  "type": "object",
  "required": [
    "$pkm",
    "$passage"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "passage"
        },
        "archetype": {
          "const": "stage_gate_manifest"
        }
      }
    },
    "$passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "origin",
        "destination",
        "departure_utc",
        "legs"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "planning",
            "booked",
            "en_route",
            "completed",
            "cancelled"
          ]
        },
        "origin": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "departure_utc": {
          "type": "string",
          "format": "date-time"
        },
        "arrival_utc": {
          "type": "string",
          "format": "date-time"
        },
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "leg_id",
              "mode",
              "carrier",
              "identifier"
            ],
            "properties": {
              "leg_id": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "flight",
                  "rail",
                  "ferry",
                  "road",
                  "foot"
                ]
              },
              "carrier": {
                "type": "string"
              },
              "identifier": {
                "type": "string"
              },
              "departure": {
                "type": "string"
              },
              "arrival": {
                "type": "string"
              }
            }
          }
        },
        "booking_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}