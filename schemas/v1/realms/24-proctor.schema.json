{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/proctor.schema.json",
  "title": "Proctor Realm Schema (24)",
  "type": "object",
  "required": [
    "$pkm",
    "$proctor"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "proctor"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$proctor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "matter_id",
        "governing_jurisdiction",
        "status"
      ],
      "properties": {
        "document_type": {
          "type": "string",
          "enum": [
            "contract",
            "pacer_filing",
            "bylaw",
            "statutory_code",
            "license",
            "brief"
          ]
        },
        "matter_id": {
          "type": "string"
        },
        "governing_jurisdiction": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "executed",
            "filed",
            "litigation_hold",
            "expired"
          ]
        },
        "parties": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "effective_date": {
          "type": "string",
          "format": "date"
        },
        "expiration_date": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}