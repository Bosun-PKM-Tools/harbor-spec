{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/trajectory.schema.json",
  "title": "Trajectory Realm Schema (37)",
  "type": "object",
  "required": [
    "$pkm",
    "$trajectory"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "trajectory"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_title",
        "organization",
        "start_date",
        "is_current",
        "verified_skills"
      ],
      "properties": {
        "role_title": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "is_current": {
          "type": "boolean"
        },
        "employment_type": {
          "type": "string",
          "enum": [
            "freelance",
            "full_time",
            "contract",
            "advisory",
            "founder"
          ]
        },
        "compensation_usd": {
          "type": "number",
          "minimum": 0
        },
        "verified_skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  }
}