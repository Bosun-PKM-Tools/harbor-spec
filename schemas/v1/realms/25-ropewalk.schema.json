{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/ropewalk.schema.json",
  "title": "Ropewalk Realm Schema (25)",
  "type": "object",
  "required": [
    "$pkm",
    "$ropewalk"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "ropewalk"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$ropewalk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_name",
        "vcs_type",
        "primary_language",
        "is_monorepo"
      ],
      "properties": {
        "repo_name": {
          "type": "string"
        },
        "vcs_type": {
          "type": "string",
          "enum": [
            "git",
            "pijul",
            "hg"
          ]
        },
        "primary_language": {
          "type": "string",
          "enum": [
            "rust",
            "python",
            "typescript",
            "nix",
            "c",
            "go",
            "shell"
          ]
        },
        "is_monorepo": {
          "type": "boolean"
        },
        "default_branch": {
          "type": "string",
          "default": "main"
        },
        "flake_uri": {
          "type": "string"
        },
        "local_clone_path": {
          "type": "string"
        }
      }
    }
  }
}