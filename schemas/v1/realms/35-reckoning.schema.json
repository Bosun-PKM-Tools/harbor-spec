{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/reckoning.schema.json",
  "title": "Reckoning Realm Schema (35)",
  "type": "object",
  "required": [
    "$pkm",
    "$reckoning"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "reckoning"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$reckoning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heuristic_name",
        "domain",
        "core_maxim",
        "pre_mortem_checklist"
      ],
      "properties": {
        "heuristic_name": {
          "type": "string"
        },
        "domain": {
          "type": "string",
          "enum": [
            "systems_thinking",
            "risk_mitigation",
            "probabilistic",
            "stoic_governance",
            "game_theory"
          ]
        },
        "core_maxim": {
          "type": "string"
        },
        "originator": {
          "type": "string"
        },
        "pre_mortem_checklist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  }
}