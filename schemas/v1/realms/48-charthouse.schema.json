{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/charthouse.schema.json",
  "title": "Charthouse Realm Schema (48)",
  "type": "object",
  "required": [
    "$pkm",
    "$charthouse"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "charthouse"
        },
        "archetype": {
          "const": "stage_gate_manifest"
        }
      }
    },
    "$charthouse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex_title",
        "canon_level",
        "timeline_epoch",
        "scene_sequence"
      ],
      "properties": {
        "codex_title": {
          "type": "string"
        },
        "canon_level": {
          "type": "string",
          "enum": [
            "core_canon",
            "apocrypha",
            "draft_fork",
            "world_lore"
          ]
        },
        "timeline_epoch": {
          "type": "string"
        },
        "scene_sequence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scene_id",
              "heading",
              "pov_character"
            ],
            "properties": {
              "scene_id": {
                "type": "string"
              },
              "heading": {
                "type": "string"
              },
              "pov_character": {
                "type": "string",
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        }
      }
    }
  }
}