{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/reverie.schema.json",
  "title": "Reverie Realm Schema (42)",
  "type": "object",
  "required": [
    "$pkm",
    "$reverie"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "reverie"
        },
        "archetype": {
          "const": "interaction_ledger"
        }
      }
    },
    "$reverie": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lucidity_level",
        "motifs",
        "emotional_tone"
      ],
      "properties": {
        "lucidity_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "emotional_tone": {
          "type": "string"
        },
        "motifs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "sleep_cycle_ref": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    }
  }
}