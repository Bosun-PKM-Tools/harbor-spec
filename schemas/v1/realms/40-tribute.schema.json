{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/tribute.schema.json",
  "title": "Tribute Realm Schema (40)",
  "type": "object",
  "required": [
    "$pkm",
    "$tribute"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "tribute"
        },
        "archetype": {
          "const": "interaction_ledger"
        }
      }
    },
    "$tribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient_ref",
        "occasion_calendar",
        "gift_history"
      ],
      "properties": {
        "recipient_ref": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sizing_profile": {
          "type": "object",
          "additionalProperties": true
        },
        "occasion_calendar": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "occasion",
              "date_recurring"
            ],
            "properties": {
              "occasion": {
                "type": "string"
              },
              "date_recurring": {
                "type": "string",
                "pattern": "^[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        },
        "gift_history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "item_description",
              "cost_usd",
              "reciprocity_direction"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 1900
              },
              "item_description": {
                "type": "string"
              },
              "cost_usd": {
                "type": "number",
                "minimum": 0
              },
              "reciprocity_direction": {
                "type": "string",
                "enum": [
                  "given",
                  "received"
                ]
              }
            }
          }
        }
      }
    }
  }
}