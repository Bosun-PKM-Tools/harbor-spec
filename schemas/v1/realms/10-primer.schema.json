{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/primer.schema.json",
  "title": "Primer Realm Schema (10)",
  "type": "object",
  "required": [
    "$pkm",
    "$primer"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "primer"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$primer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_type",
        "difficulty_factor",
        "repetition_interval_days"
      ],
      "properties": {
        "card_type": {
          "type": "string",
          "enum": [
            "concept",
            "cloze",
            "equation",
            "code_snippet"
          ]
        },
        "difficulty_factor": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 5.0
        },
        "repetition_interval_days": {
          "type": "integer",
          "minimum": 1
        },
        "last_reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "prerequisite_concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      }
    }
  }
}