{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/commonplace.schema.json",
  "title": "Commonplace Realm Schema (18)",
  "type": "object",
  "required": [
    "$pkm",
    "$commonplace"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "commonplace"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$commonplace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "media_format",
        "reading_status"
      ],
      "properties": {
        "author": {
          "type": "string"
        },
        "media_format": {
          "type": "string",
          "enum": [
            "book_hardcover",
            "book_paperback",
            "ebook",
            "audiobook",
            "monograph",
            "essay"
          ]
        },
        "reading_status": {
          "type": "string",
          "enum": [
            "queued",
            "reading",
            "finished",
            "abandoned",
            "reference"
          ]
        },
        "isbn_13": {
          "type": "string",
          "pattern": "^(978|979)[0-9]{10}$"
        },
        "publication_year": {
          "type": "integer",
          "minimum": 1400
        },
        "rating_out_of_five": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 5.0
        },
        "w3c_annotations_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}