{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/legacy.schema.json",
  "title": "Legacy Realm Schema (28)",
  "type": "object",
  "required": [
    "$pkm",
    "$legacy"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "legacy"
        },
        "archetype": {
          "const": "sovereign_vault"
        }
      }
    },
    "$legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_type",
        "payload_cas_urn",
        "encryption_format",
        "primary_executor"
      ],
      "properties": {
        "instrument_type": {
          "type": "string",
          "enum": [
            "will_testament",
            "revocable_trust",
            "power_of_attorney",
            "healthcare_proxy",
            "dead_man_manifest"
          ]
        },
        "payload_cas_urn": {
          "type": "string",
          "pattern": "^urn:cas:sha256:[a-f0-9]{64}$"
        },
        "encryption_format": {
          "type": "string",
          "enum": [
            "age-x25519",
            "age-armor",
            "fips-140-3-hsm"
          ]
        },
        "primary_executor": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "witness_identities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "last_attestation_date": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}