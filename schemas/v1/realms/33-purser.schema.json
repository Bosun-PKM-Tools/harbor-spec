{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/purser.schema.json",
  "title": "Purser Realm Schema (33)",
  "type": "object",
  "required": [
    "$pkm",
    "$purser"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "purser"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$purser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_name",
        "billing_interval",
        "cost_usd",
        "payment_method_ref",
        "auto_renew"
      ],
      "properties": {
        "service_name": {
          "type": "string"
        },
        "billing_interval": {
          "type": "string",
          "enum": [
            "monthly",
            "annual",
            "quarterly",
            "usage_based"
          ]
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "payment_method_ref": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "auto_renew": {
          "type": "boolean"
        },
        "next_renewal_date": {
          "type": "string",
          "format": "date"
        },
        "cancellation_url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}