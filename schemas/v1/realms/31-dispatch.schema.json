{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/dispatch.schema.json",
  "title": "Dispatch Realm Schema (31)",
  "type": "object",
  "required": [
    "$pkm",
    "$dispatch"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "dispatch"
        },
        "archetype": {
          "const": "interaction_ledger"
        }
      }
    },
    "$dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "channel",
        "correspondent_ref",
        "subject"
      ],
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "inbound",
            "outbound"
          ]
        },
        "channel": {
          "type": "string",
          "enum": [
            "physical_mail",
            "certified_postal",
            "email",
            "courier",
            "telex"
          ]
        },
        "correspondent_ref": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "subject": {
          "type": "string"
        },
        "tracking_number": {
          "type": "string"
        },
        "requires_response": {
          "type": "boolean"
        },
        "delivered_date": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}