{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/careen.schema.json",
  "title": "Careen Realm Schema (09)",
  "type": "object",
  "required": [
    "$pkm",
    "$careen"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "careen"
        },
        "archetype": {
          "const": "stage_gate_manifest"
        }
      }
    },
    "$careen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "milestones",
        "lead_assignee"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "drydock_discovery",
            "hull_refit",
            "sea_trials",
            "commissioned",
            "mothballed"
          ]
        },
        "lead_assignee": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "completed"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "completed": {
                "type": "boolean"
              }
            }
          }
        },
        "target_release_date": {
          "type": "string",
          "format": "date"
        },
        "campaign_lore_node": {
          "type": "string"
        }
      }
    }
  }
}