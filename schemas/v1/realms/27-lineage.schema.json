{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/lineage.schema.json",
  "title": "Lineage Realm Schema (27)",
  "type": "object",
  "required": [
    "$pkm",
    "$lineage"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "lineage"
        },
        "archetype": {
          "const": "interaction_ledger"
        }
      }
    },
    "$lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "individual_name",
        "vital_dates",
        "pedigree_generation"
      ],
      "properties": {
        "individual_name": {
          "type": "string"
        },
        "gedcom_id": {
          "type": "string"
        },
        "pedigree_generation": {
          "type": "integer",
          "minimum": 0
        },
        "vital_dates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "birth_date"
          ],
          "properties": {
            "birth_date": {
              "type": "string"
            },
            "birth_place": {
              "type": "string"
            },
            "death_date": {
              "type": "string"
            },
            "death_place": {
              "type": "string"
            }
          }
        },
        "biological_parents": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "maxItems": 2
        }
      }
    }
  }
}