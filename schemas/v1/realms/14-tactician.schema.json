{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/tactician.schema.json",
  "title": "Tactician Realm Schema (14)",
  "type": "object",
  "required": [
    "$pkm",
    "$tactician"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "tactician"
        },
        "archetype": {
          "const": "dual_track_telemetry"
        }
      }
    },
    "$tactician": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_type",
        "telemetry_sink",
        "duration_seconds",
        "distance_meters",
        "splits"
      ],
      "properties": {
        "activity_type": {
          "type": "string",
          "enum": [
            "sailing_race",
            "rowing",
            "cycling",
            "running",
            "strength"
          ]
        },
        "telemetry_sink": {
          "type": "string",
          "pattern": "^.+[.]parquet$"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "distance_meters": {
          "type": "number",
          "minimum": 0
        },
        "average_speed_knots": {
          "type": "number",
          "minimum": 0
        },
        "max_speed_knots": {
          "type": "number",
          "minimum": 0
        },
        "splits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "leg_number",
              "elapsed_seconds"
            ],
            "properties": {
              "leg_number": {
                "type": "integer",
                "minimum": 1
              },
              "elapsed_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "mark_name": {
                "type": "string"
              },
              "tactical_notes": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}