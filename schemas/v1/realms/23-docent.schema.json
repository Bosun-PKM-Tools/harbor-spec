{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/docent.schema.json",
  "title": "Docent Realm Schema (23)",
  "type": "object",
  "required": [
    "$pkm",
    "$docent"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "docent"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$docent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_type",
        "citation_key",
        "authors",
        "year",
        "title"
      ],
      "properties": {
        "entry_type": {
          "type": "string",
          "enum": [
            "article",
            "book",
            "inproceedings",
            "phdthesis",
            "techreport",
            "misc"
          ]
        },
        "citation_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1500
        },
        "doi": {
          "type": "string",
          "pattern": "^10[.][0-9]{4,9}/[-._;()/:A-Za-z0-9]+$"
        },
        "arxiv_id": {
          "type": "string",
          "pattern": "^[0-9]{4}[.][0-9]{4,5}(v[0-9]+)?$"
        },
        "publication_venue": {
          "type": "string"
        }
      }
    }
  }
}