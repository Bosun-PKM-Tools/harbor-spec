{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/commonwealth.schema.json",
  "title": "Commonwealth Realm Schema (49)",
  "type": "object",
  "required": [
    "$pkm",
    "$commonwealth"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "commonwealth"
        },
        "archetype": {
          "const": "interaction_ledger"
        }
      }
    },
    "$commonwealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_name",
        "organization",
        "service_hours",
        "impact_metrics"
      ],
      "properties": {
        "program_name": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "service_hours": {
          "type": "number",
          "minimum": 0
        },
        "role": {
          "type": "string"
        },
        "impact_metrics": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}