{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/drydock.schema.json",
  "title": "Drydock Realm Schema (15)",
  "type": "object",
  "required": [
    "$pkm",
    "$drydock"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "drydock"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$drydock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_type",
        "parcel_id",
        "gross_square_feet",
        "maintenance_ledger"
      ],
      "properties": {
        "property_type": {
          "type": "string",
          "enum": [
            "residential",
            "commercial",
            "slipway",
            "hangar",
            "raw_land"
          ]
        },
        "parcel_id": {
          "type": "string"
        },
        "gross_square_feet": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "year_built": {
          "type": "integer",
          "minimum": 1700
        },
        "maintenance_ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "system",
              "cost_usd",
              "contractor_ref"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "system": {
                "type": "string",
                "enum": [
                  "roofing",
                  "hvac",
                  "plumbing",
                  "electrical",
                  "structural",
                  "dock_piling"
                ]
              },
              "cost_usd": {
                "type": "number",
                "minimum": 0
              },
              "contractor_ref": {
                "type": "string",
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "warranty_expiration": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    }
  }
}