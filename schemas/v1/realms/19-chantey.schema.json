{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/chantey.schema.json",
  "title": "Chantey Realm Schema (19)",
  "type": "object",
  "required": [
    "$pkm",
    "$chantey"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "chantey"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$chantey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audio_format",
        "duration_seconds",
        "media_cas",
        "channels"
      ],
      "properties": {
        "audio_format": {
          "type": "string",
          "enum": [
            "flac",
            "wav",
            "mp3",
            "opus",
            "aac"
          ]
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sample_rate_hz": {
          "type": "integer",
          "enum": [
            44100,
            48000,
            96000,
            192000
          ]
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "media_cas": {
          "type": "string",
          "pattern": "^urn:cas:sha256:[a-f0-9]{64}$"
        },
        "transcript_cas": {
          "type": "string",
          "pattern": "^urn:cas:sha256:[a-f0-9]{64}$"
        },
        "v4v_recipient": {
          "type": "string"
        }
      }
    }
  }
}