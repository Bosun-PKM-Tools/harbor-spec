{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/weft.schema.json",
  "title": "Weft Realm Schema (41)",
  "type": "object",
  "required": [
    "$pkm",
    "$weft"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "weft"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$weft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_type",
        "fiber_composition",
        "care_instructions",
        "condition"
      ],
      "properties": {
        "item_type": {
          "type": "string",
          "enum": [
            "outerwear_foul_weather",
            "technical_layer",
            "footwear",
            "tailored_suit",
            "canvas_workwear"
          ]
        },
        "brand": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "condition": {
          "type": "string",
          "enum": [
            "new",
            "excellent",
            "serviceable",
            "repaired",
            "retired"
          ]
        },
        "fiber_composition": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "material",
              "percentage"
            ],
            "properties": {
              "material": {
                "type": "string"
              },
              "percentage": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          },
          "minItems": 1
        },
        "care_instructions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wash_temp_c",
            "dry_method"
          ],
          "properties": {
            "wash_temp_c": {
              "type": "integer",
              "minimum": 0,
              "maximum": 90
            },
            "dry_method": {
              "type": "string",
              "enum": [
                "tumble_low",
                "line_dry",
                "dry_flat",
                "do_not_tumble"
              ]
            },
            "dwr_reproof_recommended": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}