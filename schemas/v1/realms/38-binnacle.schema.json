{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/binnacle.schema.json",
  "title": "Binnacle Realm Schema (38)",
  "type": "object",
  "required": [
    "$pkm",
    "$binnacle"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "binnacle"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$binnacle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credo_name",
        "tradition",
        "axiom",
        "corollaries"
      ],
      "properties": {
        "credo_name": {
          "type": "string"
        },
        "tradition": {
          "type": "string",
          "enum": [
            "stoicism",
            "existentialism",
            "christian_theology",
            "pragmatism",
            "virtue_ethics"
          ]
        },
        "axiom": {
          "type": "string"
        },
        "canonical_source": {
          "type": "string"
        },
        "corollaries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  }
}