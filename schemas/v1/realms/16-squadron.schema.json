{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/squadron.schema.json",
  "title": "Squadron Realm Schema (16)",
  "type": "object",
  "required": [
    "$pkm",
    "$squadron"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "squadron"
        },
        "archetype": {
          "const": "dual_track_telemetry"
        }
      }
    },
    "$squadron": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vin_or_hull_id",
        "asset_name",
        "engine_hours",
        "telemetry_sink",
        "service_records"
      ],
      "properties": {
        "vin_or_hull_id": {
          "type": "string"
        },
        "asset_name": {
          "type": "string"
        },
        "propulsion_type": {
          "type": "string",
          "enum": [
            "inboard_diesel",
            "outboard_gas",
            "electric",
            "sail_auxiliary",
            "manual"
          ]
        },
        "engine_hours": {
          "type": "number",
          "minimum": 0
        },
        "odometer_miles": {
          "type": "number",
          "minimum": 0
        },
        "telemetry_sink": {
          "type": "string",
          "pattern": "^.+[.]parquet$"
        },
        "service_records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "service_date",
              "description",
              "interval_hours"
            ],
            "properties": {
              "service_date": {
                "type": "string",
                "format": "date"
              },
              "description": {
                "type": "string"
              },
              "interval_hours": {
                "type": "number",
                "minimum": 0
              },
              "serviced_by_contact": {
                "type": "string",
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        }
      }
    }
  }
}