{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/breadboard.schema.json",
  "title": "Breadboard Realm Schema (46)",
  "type": "object",
  "required": [
    "$pkm",
    "$breadboard"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "breadboard"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$breadboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_name",
        "mcu_architecture",
        "operating_voltage",
        "schematic_cas"
      ],
      "properties": {
        "project_name": {
          "type": "string"
        },
        "mcu_architecture": {
          "type": "string",
          "enum": [
            "esp32",
            "rp2040",
            "stm32",
            "avr",
            "nrf52",
            "risc_v"
          ]
        },
        "operating_voltage": {
          "type": "number",
          "enum": [
            3.3,
            5.0,
            12.0,
            24.0
          ]
        },
        "schematic_cas": {
          "type": "string",
          "pattern": "^urn:cas:sha256:[a-f0-9]{64}$"
        },
        "firmware_cas": {
          "type": "string",
          "pattern": "^urn:cas:sha256:[a-f0-9]{64}$"
        },
        "bus_protocols": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "i2c",
              "spi",
              "uart",
              "can",
              "nmea2000",
              "usb"
            ]
          }
        }
      }
    }
  }
}