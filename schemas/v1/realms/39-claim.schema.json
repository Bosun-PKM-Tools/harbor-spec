{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/claim.schema.json",
  "title": "Claim Realm Schema (39)",
  "type": "object",
  "required": [
    "$pkm",
    "$claim"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "claim"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ip_type",
        "title",
        "filing_status",
        "claims"
      ],
      "properties": {
        "ip_type": {
          "type": "string",
          "enum": [
            "patent_utility",
            "patent_design",
            "trademark",
            "trade_secret",
            "copyright"
          ]
        },
        "title": {
          "type": "string"
        },
        "filing_status": {
          "type": "string",
          "enum": [
            "prior_art_search",
            "provisional_filed",
            "non_provisional_pending",
            "granted",
            "abandoned"
          ]
        },
        "application_number": {
          "type": "string"
        },
        "grant_number": {
          "type": "string"
        },
        "filing_date": {
          "type": "string",
          "format": "date"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_number",
              "claim_text",
              "is_independent"
            ],
            "properties": {
              "claim_number": {
                "type": "integer",
                "minimum": 1
              },
              "claim_text": {
                "type": "string"
              },
              "is_independent": {
                "type": "boolean"
              }
            }
          },
          "minItems": 1
        }
      }
    }
  }
}