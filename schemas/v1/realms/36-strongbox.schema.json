{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/strongbox.schema.json",
  "title": "Strongbox Realm Schema (36)",
  "type": "object",
  "required": [
    "$pkm",
    "$strongbox"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "strongbox"
        },
        "archetype": {
          "const": "sovereign_vault"
        }
      }
    },
    "$strongbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_type",
        "public_identifier",
        "payload_cas_urn",
        "hardware_backed"
      ],
      "properties": {
        "key_type": {
          "type": "string",
          "enum": [
            "ssh_ed25519",
            "pgp_rsa4096",
            "age_x25519",
            "ethereum_secp256k1",
            "bitcoin_taproot"
          ]
        },
        "public_identifier": {
          "type": "string"
        },
        "payload_cas_urn": {
          "type": "string",
          "pattern": "^urn:cas:sha256:[a-f0-9]{64}$"
        },
        "hardware_backed": {
          "type": "boolean"
        },
        "token_model": {
          "type": "string"
        },
        "key_fingerprint": {
          "type": "string"
        }
      }
    }
  }
}