{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/harbor.schema.json",
  "title": "Harbor Realm Schema (06)",
  "type": "object",
  "required": [
    "$pkm",
    "$harbor"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "harbor"
        },
        "archetype": {
          "const": "stage_gate_manifest"
        }
      }
    },
    "$harbor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "syndication_target",
        "render_mode"
      ],
      "properties": {
        "route": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9_/-]*$"
        },
        "syndication_target": {
          "type": "string",
          "enum": [
            "garden",
            "directus",
            "astro",
            "all"
          ]
        },
        "render_mode": {
          "type": "string",
          "enum": [
            "static",
            "edge",
            "wasm"
          ]
        },
        "is_canonical": {
          "type": "boolean"
        },
        "live_url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}