{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/registry.schema.json",
  "title": "Registry Realm Schema (32)",
  "type": "object",
  "required": [
    "$pkm",
    "$registry"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "registry"
        },
        "archetype": {
          "const": "sovereign_vault"
        }
      }
    },
    "$registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "issuing_authority",
        "payload_cas_urn",
        "encryption_format"
      ],
      "properties": {
        "document_type": {
          "type": "string",
          "enum": [
            "passport",
            "birth_certificate",
            "tax_return",
            "vessel_registration",
            "drivers_license",
            "permit"
          ]
        },
        "issuing_authority": {
          "type": "string"
        },
        "payload_cas_urn": {
          "type": "string",
          "pattern": "^urn:cas:sha256:[a-f0-9]{64}$"
        },
        "encryption_format": {
          "type": "string",
          "enum": [
            "age-x25519",
            "age-armor",
            "fips-140-3-hsm"
          ]
        },
        "document_number_masked": {
          "type": "string"
        },
        "expiration_date": {
          "type": "string",
          "format": "date"
        },
        "jurisdiction": {
          "type": "string"
        }
      }
    }
  }
}