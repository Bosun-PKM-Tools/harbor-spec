{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/muster.schema.json",
  "title": "Muster Realm Schema (45)",
  "type": "object",
  "required": [
    "$pkm",
    "$muster"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "muster"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$muster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kit_identifier",
        "storage_location",
        "inspection_frequency_days",
        "rations_calories"
      ],
      "properties": {
        "kit_identifier": {
          "type": "string"
        },
        "storage_location": {
          "type": "string"
        },
        "inspection_frequency_days": {
          "type": "integer",
          "minimum": 1
        },
        "last_inspected_date": {
          "type": "string",
          "format": "date"
        },
        "rations_calories": {
          "type": "integer",
          "minimum": 0
        },
        "water_liters": {
          "type": "number",
          "minimum": 0
        },
        "rally_coordinates": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}