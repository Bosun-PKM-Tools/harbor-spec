{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/relay.schema.json",
  "title": "Relay Realm Schema (50)",
  "type": "object",
  "required": [
    "$pkm",
    "$relay"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "relay"
        },
        "archetype": {
          "const": "sovereign_vault"
        }
      }
    },
    "$relay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dead_man_interval_days",
        "payload_cas_urn",
        "designated_executors",
        "recovery_threshold"
      ],
      "properties": {
        "dead_man_interval_days": {
          "type": "integer",
          "minimum": 30
        },
        "payload_cas_urn": {
          "type": "string",
          "pattern": "^urn:cas:sha256:[a-f0-9]{64}$"
        },
        "last_heartbeat_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "recovery_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "designated_executors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "minItems": 1
        }
      }
    }
  }
}