{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/pavilion.schema.json",
  "title": "Pavilion Realm Schema (47)",
  "type": "object",
  "required": [
    "$pkm",
    "$pavilion"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "pavilion"
        },
        "archetype": {
          "const": "stage_gate_manifest"
        }
      }
    },
    "$pavilion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_name",
        "event_start_utc",
        "venue_name",
        "run_of_show"
      ],
      "properties": {
        "event_name": {
          "type": "string"
        },
        "event_start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "event_end_utc": {
          "type": "string",
          "format": "date-time"
        },
        "venue_name": {
          "type": "string"
        },
        "expected_headcount": {
          "type": "integer",
          "minimum": 1
        },
        "run_of_show": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time_offset_minutes",
              "segment_title"
            ],
            "properties": {
              "time_offset_minutes": {
                "type": "integer"
              },
              "segment_title": {
                "type": "string"
              },
              "lead_ref": {
                "type": "string",
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        }
      }
    }
  }
}