{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/arbor.schema.json",
  "title": "Arbor Realm Schema (29)",
  "type": "object",
  "required": [
    "$pkm",
    "$arbor"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "arbor"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$arbor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botanical_name",
        "cultivar",
        "growth_habit",
        "sun_exposure"
      ],
      "properties": {
        "botanical_name": {
          "type": "string"
        },
        "common_name": {
          "type": "string"
        },
        "cultivar": {
          "type": "string"
        },
        "growth_habit": {
          "type": "string",
          "enum": [
            "annual",
            "biennial",
            "perennial",
            "deciduous_tree",
            "evergreen_shrub",
            "vine"
          ]
        },
        "sun_exposure": {
          "type": "string",
          "enum": [
            "full_sun",
            "partial_shade",
            "full_shade"
          ]
        },
        "days_to_maturity": {
          "type": "integer",
          "minimum": 1
        },
        "soil_ph_optimal": {
          "type": "number",
          "minimum": 3.5,
          "maximum": 9.0
        }
      }
    }
  }
}