{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/provenance.schema.json",
  "title": "Provenance Realm Schema (43)",
  "type": "object",
  "required": [
    "$pkm",
    "$provenance"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "provenance"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_title",
        "medium",
        "acquisition_date",
        "chain_of_custody"
      ],
      "properties": {
        "item_title": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "creator": {
          "type": "string"
        },
        "acquisition_date": {
          "type": "string",
          "format": "date"
        },
        "appraisal_value_usd": {
          "type": "number",
          "minimum": 0
        },
        "chain_of_custody": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "custodian",
              "transfer_year"
            ],
            "properties": {
              "custodian": {
                "type": "string"
              },
              "transfer_year": {
                "type": "integer",
                "minimum": 1000
              }
            }
          },
          "minItems": 1
        }
      }
    }
  }
}