{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/gavel.schema.json",
  "title": "Gavel Realm Schema (26)",
  "type": "object",
  "required": [
    "$pkm",
    "$gavel"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "gavel"
        },
        "archetype": {
          "const": "interaction_ledger"
        }
      }
    },
    "$gavel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_name",
        "session_type",
        "quorum_present",
        "motions"
      ],
      "properties": {
        "body_name": {
          "type": "string"
        },
        "session_type": {
          "type": "string",
          "enum": [
            "board_regular",
            "board_special",
            "annual_general",
            "committee",
            "caucus"
          ]
        },
        "quorum_present": {
          "type": "boolean"
        },
        "presiding_officer": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "motions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "motion_id",
              "description",
              "outcome"
            ],
            "properties": {
              "motion_id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "moved_by": {
                "type": "string",
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "tabled",
                  "withdrawn"
                ]
              },
              "yeas": {
                "type": "integer",
                "minimum": 0
              },
              "nays": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}