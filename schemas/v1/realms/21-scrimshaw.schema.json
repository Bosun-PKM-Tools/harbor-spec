{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/scrimshaw.schema.json",
  "title": "Scrimshaw Realm Schema (21)",
  "type": "object",
  "required": [
    "$pkm",
    "$scrimshaw"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "scrimshaw"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$scrimshaw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_format",
        "target_process",
        "stock_material",
        "geometry_cas"
      ],
      "properties": {
        "model_format": {
          "type": "string",
          "enum": [
            "step",
            "iges",
            "stl",
            "f3d",
            "svg_cutsheet",
            "dxf"
          ]
        },
        "target_process": {
          "type": "string",
          "enum": [
            "cnc_milling",
            "lathe",
            "fdm_3d_print",
            "sla_resin",
            "laser_cutting",
            "waterjet"
          ]
        },
        "stock_material": {
          "type": "string"
        },
        "geometry_cas": {
          "type": "string",
          "pattern": "^urn:cas:sha256:[a-f0-9]{64}$"
        },
        "cam_toolpath_cas": {
          "type": "string",
          "pattern": "^urn:cas:sha256:[a-f0-9]{64}$"
        },
        "tolerances_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}