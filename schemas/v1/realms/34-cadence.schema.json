{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/cadence.schema.json",
  "title": "Cadence Realm Schema (34)",
  "type": "object",
  "required": [
    "$pkm",
    "$cadence"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "cadence"
        },
        "archetype": {
          "const": "stage_gate_manifest"
        }
      }
    },
    "$cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "habit_name",
        "frequency",
        "target_time_window",
        "streak_count"
      ],
      "properties": {
        "habit_name": {
          "type": "string"
        },
        "frequency": {
          "type": "string",
          "enum": [
            "daily",
            "weekdays",
            "weekly",
            "lunar_cycle"
          ]
        },
        "target_time_window": {
          "type": "string",
          "enum": [
            "morning",
            "midday",
            "evening",
            "anytime"
          ]
        },
        "streak_count": {
          "type": "integer",
          "minimum": 0
        },
        "longest_streak": {
          "type": "integer",
          "minimum": 0
        },
        "cue_trigger": {
          "type": "string"
        }
      }
    }
  }
}