{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/embers.schema.json",
  "title": "Embers Realm Schema (08)",
  "type": "object",
  "required": [
    "$pkm",
    "$embers"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "embers"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$embers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_via",
        "decay_ttl_days",
        "media_digest"
      ],
      "properties": {
        "captured_via": {
          "type": "string",
          "enum": [
            "cli_pipe",
            "dom_clipper",
            "ambient_mic",
            "camera"
          ]
        },
        "decay_ttl_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "media_digest": {
          "type": "string",
          "pattern": "^urn:cas:sha256:[a-f0-9]{64}$"
        },
        "exif_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "is_preserved": {
          "type": "boolean"
        }
      }
    }
  }
}