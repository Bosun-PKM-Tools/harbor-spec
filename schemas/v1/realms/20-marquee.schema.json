{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/marquee.schema.json",
  "title": "Marquee Realm Schema (20)",
  "type": "object",
  "required": [
    "$pkm",
    "$marquee"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "marquee"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$marquee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reel_identifier",
        "resolution",
        "frame_rate",
        "codec",
        "media_cas"
      ],
      "properties": {
        "reel_identifier": {
          "type": "string"
        },
        "resolution": {
          "type": "string",
          "enum": [
            "1080p",
            "4k_uhd",
            "4k_dci",
            "6k",
            "8k"
          ]
        },
        "frame_rate": {
          "type": "number",
          "enum": [
            23.976,
            24.0,
            25.0,
            29.97,
            30.0,
            50.0,
            59.94,
            60.0,
            120.0
          ]
        },
        "codec": {
          "type": "string",
          "enum": [
            "prores_422hq",
            "prores_4444",
            "dnxhr",
            "braw",
            "h265_10bit",
            "av1"
          ]
        },
        "color_space": {
          "type": "string",
          "enum": [
            "rec709",
            "rec2020",
            "davinci_wide_gamut",
            "acescct",
            "log_c"
          ]
        },
        "media_cas": {
          "type": "string",
          "pattern": "^urn:cas:sha256:[a-f0-9]{64}$"
        },
        "take_number": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}