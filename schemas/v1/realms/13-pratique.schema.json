{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/pratique.schema.json",
  "title": "Pratique Realm Schema (13)",
  "type": "object",
  "required": [
    "$pkm",
    "$pratique"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "pratique"
        },
        "archetype": {
          "const": "dual_track_telemetry"
        }
      }
    },
    "$pratique": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "telemetry_sink",
        "observation_type",
        "summary_metrics"
      ],
      "properties": {
        "telemetry_sink": {
          "type": "string",
          "pattern": "^.+[.]parquet$"
        },
        "observation_type": {
          "type": "string",
          "enum": [
            "vital_signs",
            "cardiac_telemetry",
            "sleep_stage",
            "lab_panel"
          ]
        },
        "fhir_resource_type": {
          "type": "string",
          "enum": [
            "Observation",
            "DiagnosticReport",
            "Condition"
          ]
        },
        "sampling_rate_hz": {
          "type": "number",
          "minimum": 0
        },
        "summary_metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mean_resting_hr",
            "hrv_rmssd_ms"
          ],
          "properties": {
            "mean_resting_hr": {
              "type": "number",
              "minimum": 30,
              "maximum": 240
            },
            "hrv_rmssd_ms": {
              "type": "number",
              "minimum": 0
            },
            "blood_pressure_systolic": {
              "type": "integer",
              "minimum": 60,
              "maximum": 250
            },
            "blood_pressure_diastolic": {
              "type": "integer",
              "minimum": 40,
              "maximum": 150
            }
          }
        }
      }
    }
  }
}