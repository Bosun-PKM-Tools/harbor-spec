{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/press.schema.json",
  "title": "Press Realm Schema (07)",
  "type": "object",
  "required": [
    "$pkm",
    "$press"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "press"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$press": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "vector_source",
        "print_spec"
      ],
      "properties": {
        "sku": {
          "type": "string",
          "pattern": "^PRS-[A-Z0-9-]+$"
        },
        "vector_source": {
          "type": "string"
        },
        "print_spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dimensions",
            "color_profile",
            "stock_weight_gsm"
          ],
          "properties": {
            "dimensions": {
              "type": "string"
            },
            "color_profile": {
              "type": "string",
              "enum": [
                "CMYK-FOGRA39",
                "sRGB",
                "Grayscale"
              ]
            },
            "stock_weight_gsm": {
              "type": "integer",
              "minimum": 50
            }
          }
        },
        "supplier": {
          "type": "string"
        }
      }
    }
  }
}