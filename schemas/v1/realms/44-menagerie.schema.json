{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/menagerie.schema.json",
  "title": "Menagerie Realm Schema (44)",
  "type": "object",
  "required": [
    "$pkm",
    "$menagerie"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "menagerie"
        },
        "archetype": {
          "const": "interaction_ledger"
        }
      }
    },
    "$menagerie": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "animal_name",
        "species",
        "breed",
        "weight_kg",
        "vaccination_ledger"
      ],
      "properties": {
        "animal_name": {
          "type": "string"
        },
        "species": {
          "type": "string",
          "enum": [
            "canine",
            "feline",
            "equine",
            "avian",
            "livestock"
          ]
        },
        "breed": {
          "type": "string"
        },
        "microchip_id": {
          "type": "string"
        },
        "weight_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "vaccination_ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vaccine_name",
              "administered_date",
              "expiration_date"
            ],
            "properties": {
              "vaccine_name": {
                "type": "string"
              },
              "administered_date": {
                "type": "string",
                "format": "date"
              },
              "expiration_date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    }
  }
}