{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bosunpkm.com/v1/realms/traverse.schema.json",
  "title": "Traverse Realm Schema (22)",
  "type": "object",
  "required": [
    "$pkm",
    "$traverse"
  ],
  "properties": {
    "$pkm": {
      "type": "object",
      "required": [
        "realm",
        "archetype"
      ],
      "properties": {
        "realm": {
          "const": "traverse"
        },
        "archetype": {
          "const": "catalog_dossier"
        }
      }
    },
    "$traverse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_type",
        "crs",
        "coordinates",
        "geometry_cas"
      ],
      "properties": {
        "feature_type": {
          "type": "string",
          "enum": [
            "Point",
            "LineString",
            "Polygon",
            "MultiPolygon",
            "FeatureCollection"
          ]
        },
        "crs": {
          "type": "string",
          "enum": [
            "EPSG:4326",
            "EPSG:3857",
            "WGS84"
          ]
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 3
        },
        "elevation_meters": {
          "type": "number"
        },
        "geometry_cas": {
          "type": "string",
          "pattern": "^urn:cas:sha256:[a-f0-9]{64}$"
        },
        "bounding_box": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    }
  }
}